# ============================================
# Real Madrid AI Platform — Environment
# ============================================

# --- Database ---
DB_PASSWORD=changeme
DATABASE_URL=postgresql://rmadmin:changeme@db:5432/real_madrid

# --- LLM Provider ---
# Options: "deepseek" (default, cloud), "ollama" (local), or "gemini" (cloud)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Only required if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Only required if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- API-Football ---
# Get a key at https://www.api-football.com/
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io/

# --- Model ---
MODEL_DIR=./models
